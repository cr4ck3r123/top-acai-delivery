    {
      "name": "Painel administrativo",
      "description": "Execute primeiro 'Obter sessão e CSRF'; o cookie de sessão é mantido pelo Postman. Login e demais POSTs exigem X-CSRF-Token.",
      "item": [
        {
          "name": "Obter sessão e CSRF",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                ""
              ]
            },
            "description": "Inicia a sessão administrativa e captura o token CSRF da página HTML. Deve ser executada antes do login."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const match = pm.response.text().match(/<meta name=\"csrf-token\" content=\"([a-f0-9]{64})\">/i);",
                  "if (match) {",
                  "  pm.collectionVariables.set('csrf_token', match[1]);",
                  "} else {",
                  "  throw new Error('Não foi possível obter o CSRF. Confira baseUrl e a resposta da página /admin/.');",
                  "}"
                ]
              }
            }
          ]
        },
