    {
      "name": "Integração SyncPay",
      "item": [
        {
          "name": "Webhook - transaction.updated",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-SyncPay-Signature",
                "value": "{{syncpay_signature}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"transaction.updated\",\n  \"event_id\": \"123e4567-e89b-42d3-a456-426614174000\",\n  \"transaction\": {\n    \"reference_id\": \"{{syncpay_reference_id}}\",\n    \"status\": \"completed\",\n    \"payment_method\": \"pix\",\n    \"amount\": {{payment_amount}},\n    \"currency\": \"BRL\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/syncpay-webhook.php",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "syncpay-webhook.php"
              ]
            },
            "description": "URL de callback deste sistema: {{baseUrl}}/api/syncpay-webhook.php (não /webhooks/syncpay). A assinatura precisa corresponder exatamente ao corpo enviado: HMAC-SHA256(secret, timestamp + '.' + rawBody), no formato t=<unix>,v1=<hex>. webhook_secret é o segredo HMAC, não a URL. Esta chamada assinada manualmente serve para teste; o callback real é enviado pela SyncPay."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const secret = pm.collectionVariables.get('webhook_secret');",
                  "if (!secret) throw new Error('Defina webhook_secret localmente; não compartilhe nem exporte esse valor.');",
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "const rawBody = pm.variables.replaceIn(pm.request.body.raw);",
                  "const signature = CryptoJS.HmacSHA256(timestamp + '.' + rawBody, secret).toString(CryptoJS.enc.Hex);",
                  "pm.variables.set('syncpay_signature', 't=' + timestamp + ',v1=' + signature);"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
